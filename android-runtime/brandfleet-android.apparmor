#include <tunables/global>

# Android init needs mount capabilities; global guest-kernel controls stay denied.
profile lxc-brandfleet-android flags=(attach_disconnected,mediate_deleted) {
  capability,
  network,
  file,
  mount,
  remount,
  umount,
  pivot_root,
  signal,
  ptrace,
  unix,
  dbus,
  deny /**/sysrq-trigger rwklx,
  deny /proc/sys/[^kvn]** wklx,
  deny /proc/sys/k[^e]** wklx,
  deny /proc/sys/ke[^r]** wklx,
  deny /proc/sys/ker[^n]** wklx,
  deny /proc/sys/kern[^e]** wklx,
  deny /proc/sys/kerne[^l]** wklx,
  deny /proc/sys/kernel[^/]** wklx,
  deny /proc/sys/kernel/[^kup]** wklx,
  deny /proc/sys/kernel/k[^p]** wklx,
  deny /proc/sys/kernel/kp[^t]** wklx,
  deny /proc/sys/kernel/kpt[^r]** wklx,
  deny /proc/sys/kernel/kptr[^_]** wklx,
  deny /proc/sys/kernel/kptr_[^r]** wklx,
  deny /proc/sys/kernel/kptr_r[^e]** wklx,
  deny /proc/sys/kernel/kptr_re[^s]** wklx,
  deny /proc/sys/kernel/kptr_res[^t]** wklx,
  deny /proc/sys/kernel/kptr_rest[^r]** wklx,
  deny /proc/sys/kernel/kptr_restr[^i]** wklx,
  deny /proc/sys/kernel/kptr_restri[^c]** wklx,
  deny /proc/sys/kernel/kptr_restric[^t]** wklx,
  deny /proc/sys/kernel/kptr_restrict?** wklx,
  deny /proc/sys/kernel/u[^n]** wklx,
  deny /proc/sys/kernel/un[^p]** wklx,
  deny /proc/sys/kernel/unp[^r]** wklx,
  deny /proc/sys/kernel/unpr[^i]** wklx,
  deny /proc/sys/kernel/unpri[^v]** wklx,
  deny /proc/sys/kernel/unpriv[^i]** wklx,
  deny /proc/sys/kernel/unprivi[^l]** wklx,
  deny /proc/sys/kernel/unprivil[^e]** wklx,
  deny /proc/sys/kernel/unprivile[^g]** wklx,
  deny /proc/sys/kernel/unprivileg[^e]** wklx,
  deny /proc/sys/kernel/unprivilege[^d]** wklx,
  deny /proc/sys/kernel/unprivileged[^_]** wklx,
  deny /proc/sys/kernel/unprivileged_[^b]** wklx,
  deny /proc/sys/kernel/unprivileged_b[^p]** wklx,
  deny /proc/sys/kernel/unprivileged_bp[^f]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf[^_]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_[^d]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_d[^i]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_di[^s]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_dis[^a]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_disa[^b]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_disab[^l]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_disabl[^e]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_disable[^d]** wklx,
  deny /proc/sys/kernel/unprivileged_bpf_disabled?** wklx,
  deny /proc/sys/kernel/p[^e]** wklx,
  deny /proc/sys/kernel/pe[^r]** wklx,
  deny /proc/sys/kernel/per[^f]** wklx,
  deny /proc/sys/kernel/perf[^_]** wklx,
  deny /proc/sys/kernel/perf_[^e]** wklx,
  deny /proc/sys/kernel/perf_e[^v]** wklx,
  deny /proc/sys/kernel/perf_ev[^e]** wklx,
  deny /proc/sys/kernel/perf_eve[^n]** wklx,
  deny /proc/sys/kernel/perf_even[^t]** wklx,
  deny /proc/sys/kernel/perf_event[^_]** wklx,
  deny /proc/sys/kernel/perf_event_[^p]** wklx,
  deny /proc/sys/kernel/perf_event_p[^a]** wklx,
  deny /proc/sys/kernel/perf_event_pa[^r]** wklx,
  deny /proc/sys/kernel/perf_event_par[^a]** wklx,
  deny /proc/sys/kernel/perf_event_para[^n]** wklx,
  deny /proc/sys/kernel/perf_event_paran[^o]** wklx,
  deny /proc/sys/kernel/perf_event_parano[^i]** wklx,
  deny /proc/sys/kernel/perf_event_paranoi[^d]** wklx,
  deny /proc/sys/kernel/perf_event_paranoid?** wklx,
  deny /proc/sys/v[^m]** wklx,
  deny /proc/sys/vm[^/]** wklx,
  deny /proc/sys/vm/[^m]** wklx,
  deny /proc/sys/vm/m[^m]** wklx,
  deny /proc/sys/vm/mm[^a]** wklx,
  deny /proc/sys/vm/mma[^p]** wklx,
  deny /proc/sys/vm/mmap[^_]** wklx,
  deny /proc/sys/vm/mmap_[^r]** wklx,
  deny /proc/sys/vm/mmap_r[^n]** wklx,
  deny /proc/sys/vm/mmap_rn[^d]** wklx,
  deny /proc/sys/vm/mmap_rnd[^_]** wklx,
  deny /proc/sys/vm/mmap_rnd_[^bc]** wklx,
  deny /proc/sys/vm/mmap_rnd_b[^i]** wklx,
  deny /proc/sys/vm/mmap_rnd_bi[^t]** wklx,
  deny /proc/sys/vm/mmap_rnd_bit[^s]** wklx,
  deny /proc/sys/vm/mmap_rnd_bits?** wklx,
  deny /proc/sys/vm/mmap_rnd_c[^o]** wklx,
  deny /proc/sys/vm/mmap_rnd_co[^m]** wklx,
  deny /proc/sys/vm/mmap_rnd_com[^p]** wklx,
  deny /proc/sys/vm/mmap_rnd_comp[^a]** wklx,
  deny /proc/sys/vm/mmap_rnd_compa[^t]** wklx,
  deny /proc/sys/vm/mmap_rnd_compat[^_]** wklx,
  deny /proc/sys/vm/mmap_rnd_compat_[^b]** wklx,
  deny /proc/sys/vm/mmap_rnd_compat_b[^i]** wklx,
  deny /proc/sys/vm/mmap_rnd_compat_bi[^t]** wklx,
  deny /proc/sys/vm/mmap_rnd_compat_bit[^s]** wklx,
  deny /proc/sys/vm/mmap_rnd_compat_bits?** wklx,
  deny /proc/sys/n[^e]** wklx,
  deny /proc/sys/ne[^t]** wklx,
  deny /proc/sys/net[^/]** wklx,
  # The writable substitute cannot be unmounted, overmounted or remounted.
  deny mount fstype=proc,
  deny mount -> /proc{,/**},
  deny remount /proc{,/**},
  deny umount /proc{,/**},
  # Linux chroots can bind /proc for reads; their sysctl aliases stay protected.
  deny /{data,tmp,mnt,dev,sys,system,vendor,product,odm,apex,storage,root,cache,config,metadata}/**/sys/** wklx,
  deny /**/kcore rwklx,
  deny /proc/keys rwklx,
  deny /sys/kernel/** wklx,
  deny /sys/devices/** wklx,
  deny /sys/power/** wklx,
  deny /sys/module/** wklx,
  deny /sys/bus/** wklx,
  deny /sys/class/** wklx,
}
